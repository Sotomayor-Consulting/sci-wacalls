# Motor de llamadas en el VPS. Copiar como .env junto al compose.
# Generar las claves con:  openssl rand -hex 32

# Clave MAESTRA: acceso total a la API (sesiones, mensajes, config).
WACALLS_API_KEY=
# Clave ACOTADA para widget.js. Queda visible en el DOM de Chatwoot, así que
# solo autoriza resolver el contacto y operar llamadas. NUNCA poner acá la
# maestra.
WACALLS_WIDGET_KEY=

# IP PÚBLICA del VPS. Es la que el motor le anuncia al navegador como destino
# del audio; con una IP privada la llamada conecta y no se escucha nada.
WACALLS_PUBLIC_IP=
# Debe estar abierto en el firewall del proveedor (UDP).
WACALLS_UDP_PORT=50000

# Chatwoot: URL PÚBLICA (no rails:3000 — Chatwoot no está en esta máquina).
WACALLS_CHATWOOT_URL=https://chat.tudominio.com
WACALLS_CHATWOOT_ACCOUNT_ID=
# Access token de un agente (Chatwoot > Profile Settings).
WACALLS_CHATWOOT_TOKEN=
WACALLS_CHATWOOT_INBOX_ID=
WACALLS_CHATWOOT_INBOX_IDENTIFIER=
# Nombre de la sesión a la que se aplica esta config.
WACALLS_CHATWOOT_SESSION=inbox-b
