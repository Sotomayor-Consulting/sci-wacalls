# Copiar en la pestaña Environment del recurso wacalls en Coolify.
# Generar las claves con: openssl rand -hex 32

# Clave MAESTRA: acceso total a la API (sesiones, mensajes, config).
WACALLS_API_KEY=
# Clave ACOTADA para widget.js. Queda visible en el DOM de Chatwoot, así que
# solo autoriza resolver el contacto y operar llamadas. NUNCA poner acá la
# maestra.
WACALLS_WIDGET_KEY=

# IP PÚBLICA del servidor de Coolify (no la interna de Docker).
WACALLS_PUBLIC_IP=
# Debe estar abierto en el firewall del proveedor (UDP), además de publicado
# acá.
WACALLS_UDP_PORT=50000

# Nombre de servicio/contenedor de Chatwoot en Coolify, tras activar "Connect
# to Predefined Network" en los dos recursos. NUNCA el dominio público de
# Chatwoot para esto — riesgo de hairpin NAT si están en el mismo servidor.
# Confirmar el nombre real con: docker ps --format '{{.Names}}' | grep rails
WACALLS_CHATWOOT_URL=http://rails:3000
WACALLS_CHATWOOT_ACCOUNT_ID=
# Access token de un agente dedicado (Chatwoot > Profile Settings), no el de
# una persona.
WACALLS_CHATWOOT_TOKEN=
WACALLS_CHATWOOT_INBOX_ID=
WACALLS_CHATWOOT_INBOX_IDENTIFIER=
# Nombre de la sesión a la que se aplica esta config. Con UNA sola sesión se
# aplica igual aunque el nombre no coincida (avisando en el log).
WACALLS_CHATWOOT_SESSION=inbox-b

# El webhook_url del inbox apunta a una dirección de red interna: Chatwoot
# necesita esta variable en TRUE para no bloquearlo por su protección
# anti-SSRF.
SAFE_FETCH_ALLOW_PRIVATE_NETWORK=true

# Grabación de llamadas. Vacío = toggle por API. Revisar el requisito legal de
# consentimiento antes de activarla con un número real.
WACALLS_RECORDING=false
